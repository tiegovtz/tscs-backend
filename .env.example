# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tscs?retryWrites=true&w=majority

# JWT Secret Key (change this in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Superadmin (for npm run create-superadmin)
SUPERADMIN_EMAIL=your-real-email@example.com
SUPERADMIN_PASSWORD=your-secure-password
SUPERADMIN_NAME=Your Name
SUPERADMIN_PHONE=+255712345678

# Easymail is the primary email provider. Create a sender-bound key in the
# TSCS workspace at https://easymail-nu.vercel.app/dashboard/api-keys.
EASYMAIL_API_URL=https://easymail-nu.vercel.app/api/v1/emails
EASYMAIL_API_KEY=gms_your_sender_bound_api_key

# Optional direct SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_ENABLED=true
SMTP_USER=your-email@gmail.com
# Use an app password or SMTP credential, never the mailbox password.
SMTP_PASS=your-smtp-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=TSCS
# Existing deployments may continue using GMAIL_USER and GMAIL_APP_PASSWORD;
# they are mapped to Gmail SMTP when the generic SMTP values are absent.
# BREVO_API_KEY and BREVO_SENDER_EMAIL may be retained as an HTTPS delivery
# fallback where infrastructure blocks outbound SMTP ports.

# Video compression / background worker
REDIS_URL=redis://127.0.0.1:6379
VIDEO_TARGET_MB=100
MAX_VIDEO_UPLOAD_GB=10
VIDEO_WORKER_CONCURRENCY=1
